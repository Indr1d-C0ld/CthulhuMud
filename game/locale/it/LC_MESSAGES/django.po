#~ " <txt>  - any non-command is appended to the end of the buffer.\n"
#~ " :  <l> - view buffer or only line(s) <l>\n"
#~ " :: <l> - raw-view buffer or only line(s) <l>\n"
#~ " :::    - escape - enter ':' as the only character on the line.\n"
#~ " :h     - this help.\n"
#~ "\n"
#~ " :w     - save the buffer (don't quit)\n"
#~ " :wq    - save buffer and quit\n"
#~ " :q     - quit (will be asked to save if buffer was changed)\n"
#~ " :q!    - quit without saving, no questions asked\n"
#~ "\n"
#~ " :u     - (undo) step backwards in undo history\n"
#~ " :uu    - (redo) step forward in undo history\n"
#~ " :UU    - reset all changes back to initial state\n"
#~ "\n"
#~ " :dd <l>     - delete last line or line(s) <l>\n"
#~ " :dw <l> <w> - delete word or regex <w> in entire buffer or on line <l>\n"
#~ " :DD         - clear entire buffer\n"
#~ "\n"
#~ " :y  <l>        - yank (copy) line(s) <l> to the copy buffer\n"
#~ " :x  <l>        - cut line(s) <l> and store it in the copy buffer\n"
#~ " :p  <l>        - put (paste) previously copied line(s) directly after <l>\n"
#~ " :i  <l> <txt>  - insert new text <txt> at line <l>. Old line will move down\n"
#~ " :r  <l> <txt>  - replace line <l> with text <txt>\n"
#~ " :I  <l> <txt>  - insert text at the beginning of line <l>\n"
#~ " :A  <l> <txt>  - append text after the end of line <l>\n"
#~ "\n"
#~ " :s <l> <w> <txt> - search/replace word or regex <w> in buffer or on line <l>\n"
#~ "\n"
#~ " :j <l> <w> - justify buffer or line <l>. <w> is f, c, l or r. Default f (full)\n"
#~ " :f <l>     - flood-fill entire buffer or line <l>: Equivalent to :j left\n"
#~ " :fi <l>    - indent entire buffer or line <l>\n"
#~ " :fd <l>    - de-indent entire buffer or line <l>\n"
#~ "\n"
#~ " :echo - turn echoing of the input on/off (helpful for some clients)\n"
#~ msgstr ""
#~ "\n"
#~ " <txt>  - qualsiasi input che non sia un comando viene aggiunto in fondo al buffer.\n"
#~ " :  <l> - visualizza il buffer o solo la/le riga/righe <l>\n"
#~ " :: <l> - visualizza il buffer (o la riga <l>) in formato grezzo\n"
#~ " :::    - escape - inserisce ':' come unico carattere della riga.\n"
#~ " :h     - questo aiuto.\n"
#~ "\n"
#~ " :w     - salva il buffer (senza uscire)\n"
#~ " :wq    - salva il buffer ed esci\n"
#~ " :q     - esci (verrà chiesto di salvare se il buffer è stato modificato)\n"
#~ " :q!    - esci senza salvare, senza ulteriori richieste\n"
#~ "\n"
#~ " :u     - (annulla) torna indietro di un passo nella cronologia\n"
#~ " :uu    - (ripeti) vai avanti di un passo nella cronologia\n"
#~ " :UU    - riporta tutte le modifiche allo stato iniziale\n"
#~ "\n"
#~ " :dd <l>     - elimina l'ultima riga o la/le riga/righe <l>\n"
#~ " :dw <l> <w> - elimina la parola o l'espressione regolare <w> nell'intero buffer o sulla riga <l>\n"
#~ " :DD         - svuota l'intero buffer\n"
#~ "\n"
#~ " :y  <l>        - copia (yank) la/le riga/righe <l> nel buffer di copia\n"
#~ " :x  <l>        - taglia la/le riga/righe <l> e la/le memorizza nel buffer di copia\n"
#~ " :p  <l>        - incolla la/le riga/righe copiate in precedenza subito dopo <l>\n"
#~ " :i  <l> <txt>  - inserisce il nuovo testo <txt> alla riga <l>. La vecchia riga si sposta in basso\n"
#~ " :r  <l> <txt>  - sostituisce la riga <l> con il testo <txt>\n"
#~ " :I  <l> <txt>  - inserisce il testo all'inizio della riga <l>\n"
#~ " :A  <l> <txt>  - aggiunge il testo alla fine della riga <l>\n"
#~ "\n"
#~ " :s <l> <w> <txt> - cerca/sostituisce la parola o l'espressione regolare <w> nel buffer o sulla riga <l>\n"
#~ "\n"
#~ " :j <l> <w> - giustifica il buffer o la riga <l>. <w> è f, c, l o r. Predefinito f (pieno)\n"
#~ " :f <l>     - riempimento continuo dell'intero buffer o della riga <l>: equivale a :j left\n"
#~ " :fi <l>    - indenta l'intero buffer o la riga <l>\n"
#~ " :fd <l>    - rimuove l'indentazione dall'intero buffer o dalla riga <l>\n"
#~ "\n"
#~ " :echo - attiva/disattiva l'eco dell'input (utile per alcuni client)\n"

