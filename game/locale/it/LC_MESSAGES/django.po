#: utils/utils.py:2256
#, python-brace-format
msgid ""
"{obj}.{handlername} is a handler and can't be set directly. To add values, "
"use `{obj}.{handlername}.add()` instead."
msgstr ""
"{obj}.{handlername} è un handler e non può essere impostato direttamente. "
"Per aggiungere valori, usa invece `{obj}.{handlername}.add()`."

#: utils/utils.py:2266
#, python-brace-format
msgid ""
"{obj}.{handlername} is a handler and can't be deleted directly. To remove "
"values, use `{obj}.{handlername}.remove()` instead."
